// The squared norm: the scalar part of `x ~x`.
fn scalar_norm_squared(x: Scalar) -> f16 {
    let t0 = x.c0.x * x.c0.x;
    return t0;
}

// Scaled to a unit versor, `(x ~x)^(-1/2) x`, so that `x ~x = 1`.
fn scalar_normalized(x: Scalar) -> Scalar {
    let p0 = f32(x.c0.x) * f32(x.c0.x);
    let s0 = f16(study_rsqrt_abs(p0));
    let t0 = x.c0.x * s0;
    return Scalar(vec4<f16>(t0, 0.0, 0.0, 0.0));
}

// One Newton step towards `x ~x = 1`, `(3 - x ~x) x / 2`, without a square root.
fn scalar_renormalize_fast(x: Scalar) -> Scalar {
    let t0 = x.c0.x * x.c0.x;
    let t1 = x.c0.x * t0;
    let t3 = x.c0.x * (3.0 / 2.0);
    let t4 = fma(-t1, (1.0 / 2.0), t3);
    return Scalar(vec4<f16>(t4, 0.0, 0.0, 0.0));
}

// The squared norm: the scalar part of `x ~x`.
fn plane_norm_squared(x: Plane) -> f16 {
    let t1 = x.c0.y * x.c0.y;
    let t3 = fma(x.c0.x, x.c0.x, t1);
    let t4 = fma(x.c0.z, x.c0.z, t3);
    return t4;
}

// Scaled to a unit versor, `(x ~x)^(-1/2) x`, so that `x ~x = 1`.
fn plane_normalized(x: Plane) -> Plane {
    let p1 = f32(x.c0.y) * f32(x.c0.y);
    let p3 = fma(f32(x.c0.x), f32(x.c0.x), p1);
    let p4 = fma(f32(x.c0.z), f32(x.c0.z), p3);
    let s0 = f16(study_rsqrt_abs(p4));
    let t0 = x.c0.x * s0;
    let t1 = x.c0.y * s0;
    let t2 = x.c0.z * s0;
    let t3 = x.c0.w * s0;
    return Plane(vec4<f16>(t0, t1, t2, t3));
}

// One Newton step towards `x ~x = 1`, `(3 - x ~x) x / 2`, without a square root.
fn plane_renormalize_fast(x: Plane) -> Plane {
    let t1 = x.c0.y * x.c0.y;
    let t3 = fma(x.c0.x, x.c0.x, t1);
    let t4 = fma(x.c0.z, x.c0.z, t3);
    let t6 = fma(-t4, (1.0 / 3.0), 1.0);
    let t7 = x.c0.x * t6;
    let t8 = x.c0.y * t6;
    let t9 = x.c0.z * t6;
    let t10 = x.c0.w * t6;
    let t11 = t7 * (3.0 / 2.0);
    let t12 = t8 * (3.0 / 2.0);
    let t13 = t9 * (3.0 / 2.0);
    let t14 = t10 * (3.0 / 2.0);
    return Plane(vec4<f16>(t11, t12, t13, t14));
}

// The squared norm: the scalar part of `x ~x`.
fn line_norm_squared(x: Line) -> f16 {
    let t1 = x.c0.y * x.c0.y;
    let t3 = fma(x.c0.x, x.c0.x, t1);
    let t4 = fma(x.c0.z, x.c0.z, t3);
    return t4;
}

// Scaled to a unit versor, `(x ~x)^(-1/2) x`, so that `x ~x = 1`.
fn line_normalized(x: Line) -> Line {
    let p1 = f32(x.c0.y) * f32(x.c0.y);
    let p4 = f32(x.c0.y) * f32(x.c1.x);
    let p6 = fma(f32(x.c0.x), f32(x.c0.x), p1);
    let p7 = fma(f32(x.c0.z), f32(x.c0.z), p6);
    let p8 = fma(f32(x.c0.x), f32(x.c0.w), p4);
    let p9 = fma(f32(x.c0.z), f32(x.c1.y), p8);
    let p10 = p9 * 2.0;
    let p11 = -p10;
    let r1 = study_rsqrt_nil(p7, p11);
    let s0 = f16(r1[0]);
    let s1 = f16(r1[1]);
    let t0 = x.c0.x * s0;
    let t1 = x.c0.y * s0;
    let t2 = x.c0.z * s0;
    let t4 = x.c0.w * s0;
    let t6 = x.c1.x * s0;
    let t8 = x.c1.y * s0;
    let t9 = fma(-x.c0.x, s1, t4);
    let t10 = fma(-x.c0.y, s1, t6);
    let t11 = fma(-x.c0.z, s1, t8);
    return Line(vec4<f16>(t0, t1, t2, t9), vec4<f16>(t10, t11, 0.0, 0.0));
}

// One Newton step towards `x ~x = 1`, `(3 - x ~x) x / 2`, without a square root.
fn line_renormalize_fast(x: Line) -> Line {
    let t0 = x.c0.x * x.c0.x;
    let t1 = x.c0.y * x.c0.y;
    let t2 = x.c0.z * x.c0.z;
    let t3 = t0 + t1;
    let t4 = t2 + t3;
    let t5 = t0 - 3.0;
    let t7 = fma(-t4, (1.0 / 3.0), 1.0);
    let t8 = x.c0.x * x.c0.w;
    let t9 = x.c0.y * x.c0.z;
    let t10 = x.c0.x * t7;
    let t11 = x.c0.y * t7;
    let t12 = x.c0.z * t7;
    let t14 = x.c0.x * x.c0.y;
    let t16 = x.c0.x * x.c0.z;
    let t17 = x.c1.y * t16;
    let t19 = x.c0.w * t2;
    let t21 = x.c1.x * t1;
    let t22 = x.c1.y * t9;
    let t24 = x.c1.x * t5;
    let t27 = x.c1.x * t9;
    let t28 = x.c1.y * t2;
    let t29 = x.c1.y * t5;
    let t30 = t10 * (3.0 / 2.0);
    let t31 = t11 * (3.0 / 2.0);
    let t32 = t12 * (3.0 / 2.0);
    let t33 = fma(x.c1.x, t14, t17);
    let t34 = fma(x.c0.w, t1, t19);
    let t36 = fma(-x.c0.x, t8, x.c0.w);
    let t38 = fma(t36, (3.0 / 2.0), -t33);
    let t39 = fma(-t34, (1.0 / 2.0), t38);
    let t40 = fma(x.c0.y, t8, t22);
    let t41 = fma(x.c1.x, t2, t24);
    let t44 = fma(t41, (1.0 / 2.0), t40);
    let t45 = fma(t21, (3.0 / 2.0), t44);
    let t46 = -t45;
    let t47 = fma(x.c0.z, t8, t27);
    let t48 = fma(x.c1.y, t1, t29);
    let t51 = fma(t48, (1.0 / 2.0), t47);
    let t52 = fma(t28, (3.0 / 2.0), t51);
    let t53 = -t52;
    return Line(vec4<f16>(t30, t31, t32, t39), vec4<f16>(t46, t53, 0.0, 0.0));
