// The exponential, a unit `Motor`: `exp(B) = C(B²) + S(B²) B`.
fn line_exp(x: Line) -> Motor {
    let p1 = f32(x.c0.y) * f32(x.c0.y);
    let p4 = f32(x.c0.y) * f32(x.c1.x);
    let p6 = fma(f32(x.c0.x), f32(x.c0.x), p1);
    let p7 = fma(f32(x.c0.z), f32(x.c0.z), p6);
    let p8 = -p7;
