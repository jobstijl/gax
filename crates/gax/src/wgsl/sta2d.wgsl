// `v x ~v` for `Odd` v and `Spatial` x (`v >> x`).
fn odd_sandwich_spatial(v: Odd, x: Spatial) -> Vector {
    let t0 = v.c0.x * v.c0.x;
    let t1 = v.c0.x * v.c0.y;
    let t3 = v.c0.z * v.c0.z;
    let t4 = v.c0.z * v.c0.w;
    let t6 = v.c0.x * v.c0.z;
    let t9 = v.c0.y * v.c0.z;
    let t10 = fma(-v.c0.y, v.c0.y, t0);
    let t11 = fma(-v.c0.w, v.c0.w, t3);
    let t12 = t10 + t11;
    let t13 = t1 + t4;
    let t14 = t1 - t4;
    let t15 = t10 - t11;
    let t16 = fma(-v.c0.y, v.c0.w, t6);
    let t17 = fma(v.c0.x, v.c0.w, t9);
    let t19 = x.c0.y * t13;
    let t20 = x.c0.x * t14;
    let t23 = x.c0.y * t17;
    let t24 = t19 * 2.0;
    let t25 = fma(x.c0.x, t12, t24);
    let t26 = t20 * 2.0;
    let t27 = fma(-x.c0.y, t15, t26);
    let t28 = fma(x.c0.x, t16, t23);
    let t29 = t28 * 2.0;
    return Vector(vec4<f32>(t25, t27, t29, 0.0));
}

// `v x ~v` for a unit `Odd` v and `Spatial` x (`v >> x`).
fn unit_odd_sandwich_spatial(v: Odd, x: Spatial) -> Vector {
    let t0 = v.c0.x * v.c0.x;
    let t1 = v.c0.x * v.c0.y;
    let t3 = v.c0.z * v.c0.z;
    let t4 = v.c0.z * v.c0.w;
    let t6 = v.c0.x * v.c0.z;
    let t9 = v.c0.y * v.c0.z;
    let t10 = fma(-v.c0.y, v.c0.y, t0);
    let t11 = fma(-v.c0.w, v.c0.w, t3);
    let t12 = t10 + t11;
    let t13 = t1 + t4;
    let t14 = t1 - t4;
    let t15 = t10 - t11;
    let t16 = fma(-v.c0.y, v.c0.w, t6);
    let t17 = fma(v.c0.x, v.c0.w, t9);
    let t19 = x.c0.y * t13;
    let t20 = x.c0.x * t14;
    let t23 = x.c0.y * t17;
    let t24 = t19 * 2.0;
    let t25 = fma(x.c0.x, t12, t24);
    let t26 = t20 * 2.0;
    let t27 = fma(-x.c0.y, t15, t26);
    let t28 = fma(x.c0.x, t16, t23);
    let t29 = t28 * 2.0;
    return Vector(vec4<f32>(t25, t27, t29, 0.0));
}

// `v x ~v` for `Odd` v and `Temporal` x (`v >> x`).
fn odd_sandwich_temporal(v: Odd, x: Temporal) -> Bivector {
    let t0 = v.c0.x * v.c0.x;
    let t1 = v.c0.x * v.c0.y;
    let t3 = v.c0.z * v.c0.z;
    let t4 = v.c0.z * v.c0.w;
    let t7 = v.c0.y * v.c0.z;
    let t8 = v.c0.x * v.c0.z;
    let t10 = fma(-v.c0.y, v.c0.y, t0);
    let t11 = fma(-v.c0.w, v.c0.w, t3);
    let t12 = fma(v.c0.x, v.c0.w, t7);
    let t13 = fma(-v.c0.y, v.c0.w, t8);
    let t14 = t10 - t11;
    let t15 = t1 - t4;
    let t16 = t1 + t4;
    let t17 = t10 + t11;
    let t18 = x.c0.x * t12;
    let t21 = x.c0.y * t15;
    let t22 = x.c0.x * t16;
    let t23 = x.c0.y * t17;
    let t24 = fma(-x.c0.y, t13, t18);
    let t25 = t24 * 2.0;
    let t26 = t21 * 2.0;
    let t27 = fma(x.c0.x, t14, t26);
    let t28 = -t27;
    let t30 = fma(-t22, 2.0, t23);
    return Bivector(vec4<f32>(t25, t28, t30, 0.0));
}

// `v x ~v` for a unit `Odd` v and `Temporal` x (`v >> x`).
fn unit_odd_sandwich_temporal(v: Odd, x: Temporal) -> Bivector {
    let t0 = v.c0.x * v.c0.x;
