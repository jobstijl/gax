    let m7 = v.c0.y * v.c0.z;
    let m8 = v.c0.y * v.c0.w;
    let m9 = v.c0.z * v.c0.w;
    let m10 = m0 - m1;
    let m11 = m2 - m3;
    let m12 = m10 + m11;
    let m13 = m4 + m9;
    let m14 = m13 * 2.0;
    let m15 = m5 + m8;
    let m16 = m15 * 2.0;
    let m17 = -m16;
    let m18 = m4 - m9;
    let m19 = m18 * 2.0;
    let m20 = m11 - m10;
    let m21 = m6 - m7;
    let m22 = m21 * 2.0;
    let m23 = m5 - m8;
    let m24 = m23 * 2.0;
    let m25 = m6 + m7;
    let m26 = m25 * 2.0;
    let m27 = m0 + m1;
    let m28 = m2 + m3;
    let m29 = m27 + m28;
    let m30 = -m29;
    let m31 = m27 - m28;
    return mat4x4<f32>(vec4<f32>(m12, m19, m24, 0.0), vec4<f32>(m14, m20, m26, 0.0), vec4<f32>(m17, m22, m30, 0.0), vec4<f32>(0.0, 0.0, 0.0, m31));
}

// `v x ~v` for `Odd` v and `Multivector` x (`v >> x`).
fn odd_sandwich_multivector(v: Odd, x: Multivector) -> Multivector {
    let t0 = v.c0.x * v.c0.x;
    let t1 = v.c0.y * v.c0.y;
    let t2 = v.c0.z * v.c0.z;
    let t3 = v.c0.w * v.c0.w;
    let t4 = v.c0.x * v.c0.y;
    let t5 = v.c0.x * v.c0.z;
    let t6 = v.c0.x * v.c0.w;
    let t7 = v.c0.y * v.c0.z;
    let t8 = v.c0.y * v.c0.w;
    let t9 = v.c0.z * v.c0.w;
    let t10 = t0 - t1;
    let t11 = t0 + t1;
    let t12 = t2 - t3;
    let t13 = t2 + t3;
    let t14 = t11 - t13;
    let t15 = t10 + t12;
    let t16 = t4 + t9;
    let t17 = t5 + t8;
    let t18 = t4 - t9;
    let t19 = t10 - t12;
    let t20 = t6 - t7;
    let t21 = t5 - t8;
    let t22 = t6 + t7;
    let t23 = t11 + t13;
    let t24 = x.c0.x * t14;
    let t26 = x.c0.z * t16;
    let t30 = x.c0.w * t20;
    let t32 = x.c0.z * t22;
    let t35 = x.c1.y * t22;
    let t37 = x.c1.x * t20;
    let t40 = x.c1.x * t17;
    let t43 = x.c1.w * t14;
    let t44 = fma(-x.c0.w, t17, t26);
    let t45 = t44 * 2.0;
    let t46 = fma(x.c0.y, t15, t45);
    let t47 = fma(x.c0.y, t18, t30);
    let t48 = t47 * 2.0;
    let t49 = fma(-x.c0.z, t19, t48);
    let t50 = fma(x.c0.y, t21, t32);
    let t51 = t50 * 2.0;
    let t52 = fma(-x.c0.w, t23, t51);
    let t53 = fma(-x.c1.z, t21, t35);
    let t54 = t53 * 2.0;
    let t55 = fma(-x.c1.x, t23, t54);
    let t56 = fma(-x.c1.z, t18, t37);
    let t57 = t56 * 2.0;
    let t58 = fma(-x.c1.y, t19, t57);
    let t59 = fma(-x.c1.y, t16, t40);
    let t60 = t59 * 2.0;
    let t61 = fma(x.c1.z, t15, t60);
    return Multivector(vec4<f32>(t24, t46, t49, t52), vec4<f32>(t55, t58, t61, t43));
}

// `v x ~v` for a unit `Odd` v and `Multivector` x (`v >> x`).
fn unit_odd_sandwich_multivector(v: Odd, x: Multivector) -> Multivector {
    let t0 = v.c0.x * v.c0.x;
    let t1 = v.c0.y * v.c0.y;
    let t2 = v.c0.z * v.c0.z;
    let t3 = v.c0.w * v.c0.w;
    let t4 = v.c0.x * v.c0.y;
    let t5 = v.c0.x * v.c0.z;
    let t6 = v.c0.x * v.c0.w;
    let t7 = v.c0.y * v.c0.z;
    let t8 = v.c0.y * v.c0.w;
    let t9 = v.c0.z * v.c0.w;
    let t10 = t0 - t1;
    let t11 = t0 + t1;
    let t12 = t2 - t3;
    let t13 = t2 + t3;
    let t14 = t11 - t13;
    let t15 = t10 + t12;
    let t16 = t4 + t9;
    let t17 = t5 + t8;
    let t18 = t4 - t9;
    let t19 = t10 - t12;
    let t20 = t6 - t7;
    let t21 = t5 - t8;
    let t22 = t6 + t7;
    let t23 = t11 + t13;
    let t24 = x.c0.x * t14;
    let t26 = x.c0.z * t16;
    let t30 = x.c0.w * t20;
    let t32 = x.c0.z * t22;
    let t35 = x.c1.y * t22;
    let t37 = x.c1.x * t20;
    let t40 = x.c1.x * t17;
    let t43 = x.c1.w * t14;
    let t44 = fma(-x.c0.w, t17, t26);
    let t45 = t44 * 2.0;
    let t46 = fma(x.c0.y, t15, t45);
    let t47 = fma(x.c0.y, t18, t30);
    let t48 = t47 * 2.0;
    let t49 = fma(-x.c0.z, t19, t48);
    let t50 = fma(x.c0.y, t21, t32);
    let t51 = t50 * 2.0;
    let t52 = fma(-x.c0.w, t23, t51);
    let t53 = fma(-x.c1.z, t21, t35);
    let t54 = t53 * 2.0;
    let t55 = fma(-x.c1.x, t23, t54);
    let t56 = fma(-x.c1.z, t18, t37);
    let t57 = t56 * 2.0;
    let t58 = fma(-x.c1.y, t19, t57);
    let t59 = fma(-x.c1.y, t16, t40);
