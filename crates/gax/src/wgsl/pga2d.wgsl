    let t2 = a.c0.x * b.c0.y;
    let t6 = a.c0.z * b.c0.y;
    let t7 = a.c0.w * b.c0.x;
    let t9 = a.c0.y * b.c0.z;
    let t11 = a.c0.w * b.c0.y;
    let t12 = fma(a.c0.x, b.c0.x, t1);
    let t13 = fma(-a.c0.y, b.c0.x, t2);
    let t14 = fma(a.c0.x, b.c0.z, t7);
    let t15 = fma(a.c0.y, b.c0.w, t6);
    let t16 = t14 - t15;
    let t17 = fma(a.c0.x, b.c0.w, t9);
    let t18 = fma(a.c0.z, b.c0.x, t11);
    let t19 = t17 + t18;
    return Flector(vec4<f32>(t12, t13, t16, t19));
}

