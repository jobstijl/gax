    let t1 = a.c0.y * b.c0.x;
    let t3 = a.c0.y * b.c0.z;
    let t7 = a.c0.w * b.c0.x;
    let t8 = fma(a.c0.x, b.c0.y, t3);
    let t9 = fma(a.c0.z, b.c0.x, t8);
    let t10 = fma(a.c0.x, b.c0.z, t7);
    let t11 = fma(-a.c0.y, b.c0.y, t10);
    return Motor(vec4<f32>(t0, t1, t9, t11));
}

// The geometric product of a `Motor` and a `Motor` (composition).
fn motor_mul_motor(a: Motor, b: Motor) -> Motor {
    let t0 = a.c0.x * b.c0.x;
    let t3 = a.c0.y * b.c0.x;
    let t5 = a.c0.y * b.c0.w;
    let t6 = a.c0.z * b.c0.x;
    let t10 = a.c0.z * b.c0.y;
    let t11 = a.c0.w * b.c0.x;
    let t12 = fma(-a.c0.y, b.c0.y, t0);
    let t13 = fma(a.c0.x, b.c0.y, t3);
    let t14 = fma(a.c0.x, b.c0.z, t5);
    let t15 = fma(-a.c0.w, b.c0.y, t6);
    let t16 = t14 + t15;
    let t17 = fma(a.c0.x, b.c0.w, t10);
    let t18 = fma(-a.c0.y, b.c0.z, t11);
    let t19 = t17 + t18;
    return Motor(vec4<f32>(t12, t13, t16, t19));
}

// The geometric product of a `Motor` and a `Flector` (composition).
fn motor_mul_flector(a: Motor, b: Flector) -> Flector {
