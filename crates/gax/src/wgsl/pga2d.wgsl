    let t2 = a.c0.x * b.c0.y;
    let t6 = a.c0.w * b.c0.x;
    let t8 = a.c0.z * b.c0.x;
    let t10 = fma(a.c0.x, b.c0.x, t1);
    let t11 = fma(-a.c0.y, b.c0.x, t2);
    let t12 = fma(a.c0.x, b.c0.z, t6);
    let t13 = fma(-a.c0.z, b.c0.y, t12);
    let t14 = fma(a.c0.y, b.c0.z, t8);
    let t15 = fma(a.c0.w, b.c0.y, t14);
    return Flector(vec4<f32>(t10, t11, t13, t15));
}

// The geometric product of a `Motor` and a `Point` (composition).
fn motor_mul_point(a: Motor, b: Point) -> Motor {
    let t0 = a.c0.y * b.c0.z;
    let t1 = a.c0.x * b.c0.z;
    let t3 = a.c0.y * b.c0.y;
    let t7 = a.c0.z * b.c0.z;
    let t8 = -t0;
    let t9 = fma(a.c0.x, b.c0.x, t3);
    let t10 = fma(-a.c0.w, b.c0.z, t9);
    let t11 = fma(a.c0.x, b.c0.y, t7);
    let t12 = fma(-a.c0.y, b.c0.x, t11);
    return Motor(vec4<f32>(t8, t1, t10, t12));
}

// The geometric product of a `Motor` and a `Rotor` (composition).
fn motor_mul_rotor(a: Motor, b: Rotor) -> Motor {
