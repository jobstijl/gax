// The exponential, a unit `Motor`: `exp(B) = C(B²) + S(B²) B`.
fn point_exp(x: Point) -> Motor {
    let p0 = x.c0.z * x.c0.z;
    let p1 = -p0;
    let r1 = study_exp_rotation(p1, 0.0);
    let c0 = r1[0];
    let c1 = r1[1];
    let s0 = r1[2];
    let s1 = r1[3];
    let t0 = x.c0.z * s0;
    let t1 = x.c0.x * s0;
    let t2 = x.c0.y * s0;
    return Motor(vec4<f32>(c0, t0, t1, t2));
}

