    let t4 = a.c0.z * b.c0.x;
    let t7 = a.c0.w * b.c0.x;
    let t8 = fma(-a.c0.y, b.c0.y, t0);
    let t9 = fma(a.c0.x, b.c0.y, t3);
    let t10 = fma(-a.c0.w, b.c0.y, t4);
    let t11 = fma(a.c0.z, b.c0.y, t7);
