    let t7 = fma(-t3, (1.0 / 2.0), t6);
    let t9 = x.c0.y * (3.0 / 2.0);
    let t10 = fma(-t4, (1.0 / 2.0), t9);
    return Rotor(vec4<f32>(t7, t10, 0.0, 0.0));
}

// The logarithm of a unit `Rotor`: the `Point` B with `exp(B) = x` (rotation half-angle in [0, pi]).
fn unit_rotor_log(x: Rotor) -> Point {
    let p0 = x.c0.y * x.c0.y;
    let p1 = -p0;
    let r1 = study_log_rotation(x.c0.x, 0.0, p1, 0.0);
    let h0 = r1[0];
    let h1 = r1[1];
    let t0 = x.c0.y * h0;
    return Point(vec4<f32>(0.0, 0.0, t0, 0.0));
}

