// The squared norm: the scalar part of `x ~x`.
fn bivector_norm_squared(x: Bivector) -> f32 {
    let t0 = x.c0.x * x.c0.x;
    let t2 = x.c0.z * x.c1.x;
    let t4 = fma(-x.c1.y, x.c1.y, t0);
    let t5 = fma(x.c0.y, x.c0.w, t2);
    let t7 = fma(-t5, 2.0, t4);
    return t7;
}

// Scaled to a unit versor, `(x ~x)^(-1/2) x`, so that `x ~x = 1`.
fn bivector_normalized(x: Bivector) -> Bivector {
    let p0 = x.c0.x * x.c0.x;
    let p2 = x.c0.z * x.c1.x;
    let p5 = x.c0.y * x.c1.x;
    let p7 = fma(-x.c1.y, x.c1.y, p0);
    let p8 = fma(x.c0.y, x.c0.w, p2);
    let p10 = fma(-p8, 2.0, p7);
    let p11 = fma(-x.c0.x, x.c1.y, p5);
    let p12 = fma(-x.c0.z, x.c0.w, p11);
    let p13 = p12 * 2.0;
    let r1 = study_rsqrt_complex(p10, p13);
    let s0 = r1[0];
    let s1 = r1[1];
    let t1 = x.c1.y * s1;
    let t2 = x.c0.y * s0;
    let t5 = x.c0.z * s0;
    let t7 = x.c1.x * s1;
    let t9 = x.c1.x * s0;
    let t11 = x.c1.y * s0;
    let t12 = fma(x.c0.x, s0, t1);
    let t13 = fma(-x.c0.z, s1, t2);
    let t14 = fma(x.c0.y, s1, t5);
    let t15 = fma(x.c0.w, s0, t7);
    let t16 = fma(-x.c0.w, s1, t9);
    let t17 = fma(-x.c0.x, s1, t11);
    return Bivector(vec4<f32>(t12, t13, t14, t15), vec4<f32>(t16, t17, 0.0, 0.0));
}

// One Newton step towards `x ~x = 1`, `x (3 - x ~x) / 2`, without a square root.
fn bivector_renormalize_fast(x: Bivector) -> Bivector {
    let t0 = x.c0.x * x.c0.x;
    let t1 = x.c1.y * x.c1.y;
    let t2 = t0 - t1;
    let t3 = t2 - 3.0;
    let t4 = x.c0.x * x.c1.y;
    let t5 = x.c0.y * x.c1.x;
    let t6 = x.c0.z * x.c0.w;
    let t7 = t4 + t6;
    let t9 = fma(-t5, 2.0, t7);
    let t10 = t4 - t5;
    let t12 = fma(t6, 2.0, t10);
    let t13 = t6 - t5;
    let t15 = fma(t13, (2.0 / 3.0), t4);
    let t16 = x.c0.y * x.c0.w;
    let t17 = x.c0.z * x.c1.x;
    let t18 = t16 + t17;
    let t19 = t3 * (1.0 / 2.0);
    let t20 = t16 - t19;
    let t21 = t17 - t19;
    let t22 = x.c0.x * t0;
    let t25 = x.c0.y * t20;
    let t28 = x.c0.z * t21;
    let t30 = x.c1.x * t12;
    let t32 = x.c1.x * t21;
    let t34 = x.c1.y * t1;
    let t37 = fma(x.c1.y, t15, x.c0.x);
    let t38 = t37 * (3.0 / 2.0);
    let t39 = fma(x.c0.x, t18, t38);
    let t40 = fma(-t22, (1.0 / 2.0), t39);
    let t41 = fma(-x.c0.z, t9, t25);
    let t42 = fma(x.c0.y, t12, t28);
    let t43 = fma(x.c0.w, t20, t30);
    let t44 = fma(-x.c0.w, t9, t32);
    let t45 = t34 * (1.0 / 2.0);
    let t46 = fma(-x.c0.x, t15, x.c1.y);
    let t48 = fma(x.c1.y, t18, t45);
    let t49 = fma(t46, (3.0 / 2.0), t48);
    return Bivector(vec4<f32>(t40, t41, t42, t43), vec4<f32>(t44, t49, 0.0, 0.0));
}

// The exponential, a unit `Even`: `exp(B) = C(B²) + S(B²) B`.
fn bivector_exp(x: Bivector) -> Even {
    let p2 = x.c0.z * x.c1.x;
    let p3 = x.c1.y * x.c1.y;
    let p6 = x.c0.z * x.c0.w;
    let p7 = fma(-x.c0.x, x.c0.x, p3);
    let p8 = fma(x.c0.y, x.c0.w, p2);
    let p10 = fma(p8, 2.0, p7);
    let p11 = fma(x.c0.x, x.c1.y, p6);
    let p12 = fma(-x.c0.y, x.c1.x, p11);
    let p13 = p12 * 2.0;
    let r1 = study_exp_complex(p10, p13);
    let c0 = r1[0];
    let c1 = r1[1];
    let s0 = r1[2];
    let s1 = r1[3];
    let t1 = x.c1.y * s1;
    let t2 = x.c0.y * s0;
    let t5 = x.c0.z * s0;
    let t7 = x.c1.x * s1;
    let t9 = x.c1.x * s0;
    let t11 = x.c1.y * s0;
    let t12 = fma(x.c0.x, s0, t1);
    let t13 = fma(-x.c0.z, s1, t2);
    let t14 = fma(x.c0.y, s1, t5);
    let t15 = fma(x.c0.w, s0, t7);
    let t16 = fma(-x.c0.w, s1, t9);
    let t17 = fma(-x.c0.x, s1, t11);
    return Even(vec4<f32>(c0, t12, t13, t14), vec4<f32>(t15, t16, t17, c1));
}

