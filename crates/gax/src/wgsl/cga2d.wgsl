// The squared norm: the scalar part of `x ~x`.
fn even_norm_squared(x: Even) -> f32 {
    let t1 = x.c0.y * x.c0.y;
    let t3 = x.c0.w * x.c1.y;
    let t5 = x.c1.w * x.c1.w;
    let t6 = fma(x.c0.x, x.c0.x, t1);
    let t7 = fma(x.c1.z, x.c1.z, t5);
    let t8 = t6 - t7;
    let t9 = fma(x.c0.z, x.c1.x, t3);
    let t11 = fma(-t9, 2.0, t8);
    return t11;
}

// Scaled to a unit versor, `(x ~x)^(-1/2) x`, so that `x ~x = 1`.
fn even_normalized(x: Even) -> Even {
    let p1 = x.c0.y * x.c0.y;
    let p3 = x.c0.w * x.c1.y;
    let p5 = x.c1.w * x.c1.w;
    let p8 = x.c0.z * x.c1.y;
    let p9 = x.c0.w * x.c1.x;
    let p10 = fma(x.c0.x, x.c0.x, p1);
    let p11 = fma(x.c1.z, x.c1.z, p5);
    let p12 = p10 - p11;
    let p13 = fma(x.c0.z, x.c1.x, p3);
    let p15 = fma(-p13, 2.0, p12);
    let p16 = fma(x.c0.x, x.c1.w, p8);
    let p17 = fma(x.c0.y, x.c1.z, p9);
    let p18 = p16 - p17;
    let p19 = p18 * 2.0;
    let r1 = study_rsqrt_complex(p15, p19);
    let s0 = r1[0];
    let s1 = r1[1];
    let t0 = x.c0.x * s0;
    let t3 = x.c1.z * s1;
    let t4 = x.c0.z * s0;
    let t7 = x.c0.w * s0;
    let t9 = x.c1.y * s1;
    let t11 = x.c1.y * s0;
    let t13 = x.c1.z * s0;
    let t15 = x.c1.w * s0;
    let t16 = fma(-x.c1.w, s1, t0);
    let t17 = fma(x.c0.y, s0, t3);
    let t18 = fma(-x.c0.w, s1, t4);
    let t19 = fma(x.c0.z, s1, t7);
    let t20 = fma(x.c1.x, s0, t9);
    let t21 = fma(-x.c1.x, s1, t11);
    let t22 = fma(-x.c0.y, s1, t13);
    let t23 = fma(x.c0.x, s1, t15);
    return Even(vec4<f32>(t16, t17, t18, t19), vec4<f32>(t20, t21, t22, t23));
}

// One Newton step towards `x ~x = 1`, `x (3 - x ~x) / 2`, without a square root.
fn even_renormalize_fast(x: Even) -> Even {
    let t0 = x.c0.x * x.c0.x;
    let t1 = x.c0.y * x.c0.y;
    let t2 = x.c1.z * x.c1.z;
    let t3 = x.c1.w * x.c1.w;
    let t4 = t0 + t1;
    let t5 = t4 - t2;
    let t6 = t3 + 3.0;
    let t7 = t5 - t6;
    let t8 = x.c0.z * x.c1.x;
    let t9 = x.c0.w * x.c1.y;
    let t10 = t8 + t9;
    let t12 = fma(t2, (1.0 / 2.0), t10);
    let t13 = x.c0.x * x.c1.w;
    let t14 = x.c0.y * x.c1.z;
    let t15 = t13 - t14;
    let t16 = x.c0.z * x.c1.y;
    let t17 = x.c0.w * x.c1.x;
    let t18 = t16 - t17;
    let t19 = t13 + t18;
    let t21 = fma(-t14, (3.0 / 2.0), t19);
    let t22 = t15 + t16;
    let t24 = fma(-t17, 2.0, t22);
