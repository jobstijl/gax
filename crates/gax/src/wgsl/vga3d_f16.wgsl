// The logarithm of a unit `Rotor`: the `Bivector` B with `exp(B) = x` (rotation half-angle in [0, pi]).
fn unit_rotor_log(x: Rotor) -> Bivector {
    let p1 = f32(x.c0.z) * f32(x.c0.z);
