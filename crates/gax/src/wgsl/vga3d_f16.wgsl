    let t3 = x.c0.w * x.c0.w;
    let t4 = fma(x.c0.x, x.c0.x, t1);
    let t5 = fma(x.c0.z, x.c0.z, t3);
    let t6 = t4 + t5;
    let t8 = fma(-t6, (1.0 / 3.0), 1.0);
    let t9 = x.c0.x * t8;
    let t10 = x.c0.y * t8;
    let t11 = x.c0.z * t8;
    let t12 = x.c0.w * t8;
    let t13 = t9 * (3.0 / 2.0);
    let t14 = t10 * (3.0 / 2.0);
    let t15 = t11 * (3.0 / 2.0);
    let t16 = t12 * (3.0 / 2.0);
    return Rotor(vec4<f16>(t13, t14, t15, t16));
