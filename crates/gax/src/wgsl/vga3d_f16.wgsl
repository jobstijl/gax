    let p4 = fma(f32(x.c0.w), f32(x.c0.w), p3);
    let p5 = -p4;
    let r1 = study_log_rotation(f32(x.c0.x), 0.0, p5, 0.0);
    let h0 = f16(r1[0]);
    let h1 = f16(r1[1]);
    let t0 = x.c0.y * h0;
    let t1 = x.c0.z * h0;
    let t2 = x.c0.w * h0;
    return Bivector(vec4<f16>(t0, t1, t2, 0.0));
