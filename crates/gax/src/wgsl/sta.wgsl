// The squared norm: the scalar part of `x ~x`.
fn scalar_norm_squared(x: Scalar) -> f32 {
    let t0 = x.c0.x * x.c0.x;
    return t0;
}

// Scaled to a unit versor, `(x ~x)^(-1/2) x`, so that `x ~x = 1`.
fn scalar_normalized(x: Scalar) -> Scalar {
    let p0 = x.c0.x * x.c0.x;
    let s0 = study_rsqrt_abs(p0);
    let t0 = x.c0.x * s0;
    return Scalar(vec4<f32>(t0, 0.0, 0.0, 0.0));
}

// One Newton step towards `x ~x = 1`, `(3 - x ~x) x / 2`, without a square root.
fn scalar_renormalize_fast(x: Scalar) -> Scalar {
    let t0 = x.c0.x * x.c0.x;
    let t1 = x.c0.x * t0;
    let t3 = x.c0.x * (3.0 / 2.0);
    let t4 = fma(-t1, (1.0 / 2.0), t3);
    return Scalar(vec4<f32>(t4, 0.0, 0.0, 0.0));
}

// The squared norm: the scalar part of `x ~x`.
fn vector_norm_squared(x: Vector) -> f32 {
    let t0 = x.c0.x * x.c0.x;
    let t3 = x.c0.w * x.c0.w;
    let t4 = fma(-x.c0.y, x.c0.y, t0);
    let t5 = fma(x.c0.z, x.c0.z, t3);
    let t6 = t4 - t5;
    return t6;
}

// Scaled to a unit versor, `(x ~x)^(-1/2) x`, so that `x ~x = 1`.
fn vector_normalized(x: Vector) -> Vector {
    let p0 = x.c0.x * x.c0.x;
    let p3 = x.c0.w * x.c0.w;
    let p4 = fma(-x.c0.y, x.c0.y, p0);
    let p5 = fma(x.c0.z, x.c0.z, p3);
    let p6 = p4 - p5;
    let s0 = study_rsqrt_abs(p6);
    let t0 = x.c0.x * s0;
    let t1 = x.c0.y * s0;
    let t2 = x.c0.z * s0;
    let t3 = x.c0.w * s0;
    return Vector(vec4<f32>(t0, t1, t2, t3));
}

// One Newton step towards `x ~x = 1`, `(3 - x ~x) x / 2`, without a square root.
fn vector_renormalize_fast(x: Vector) -> Vector {
    let t0 = x.c0.x * x.c0.x;
    let t3 = x.c0.w * x.c0.w;
    let t4 = fma(-x.c0.y, x.c0.y, t0);
    let t5 = fma(x.c0.z, x.c0.z, t3);
    let t6 = t4 - t5;
    let t8 = fma(-t6, (1.0 / 3.0), 1.0);
    let t9 = x.c0.x * t8;
    let t10 = x.c0.y * t8;
    let t11 = x.c0.z * t8;
    let t12 = x.c0.w * t8;
    let t13 = t9 * (3.0 / 2.0);
    let t14 = t10 * (3.0 / 2.0);
    let t15 = t11 * (3.0 / 2.0);
    let t16 = t12 * (3.0 / 2.0);
    return Vector(vec4<f32>(t13, t14, t15, t16));
}

