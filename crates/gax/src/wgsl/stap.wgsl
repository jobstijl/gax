    let t1 = x.c1.y * x.c1.y;
    let t3 = x.c1.w * x.c1.w;
    let t5 = x.c2.y * x.c2.y;
    let t7 = x.c3.w * x.c3.w;
    let t8 = fma(x.c0.x, x.c0.x, t1);
    let t9 = fma(x.c1.z, x.c1.z, t3);
    let t10 = t8 + t9;
